APP_NAME=MediPrepAgent
APP_VERSION=0.2.0
DEBUG=true

# Local development uses SQLite when this is omitted.
# DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/mediprep_db?charset=utf8mb4

LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=45

# Optional reranker. Retrieval falls back safely when this is not configured.
DASHSCOPE_API_KEY=
DASHSCOPE_RERANK_ENABLED=false

HOST=0.0.0.0
PORT=8000
